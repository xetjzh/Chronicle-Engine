{
  "name": "chronicle-engine-ai-api-backend-server",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "Node backend for proxying Google Cloud API requests",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env.local\" server.js",
    "test": "node --test",
    "check": "node --check server.js"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "google-auth-library": "10.9.1",
    "express-rate-limit": "7.5.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "nodemon": "3.1.11"
  }
}
