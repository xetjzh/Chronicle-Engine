# Credential-free local runtime. Copy to .env.local if desired.
API_BACKEND_HOST=127.0.0.1
API_BACKEND_PORT=5000
SERVE_FRONTEND=false
AI_PROXY_ENABLED=false
API_PAYLOAD_MAX_SIZE=7mb
API_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=false

# Required only when AI_PROXY_ENABLED=true. Exact browser origins, comma-separated.
# Both HTTP and WebSocket require a matching Origin. This is not authentication.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PROXY_HEADER is an optional PUBLIC shim marker, never a secret or authentication.
# Its default matches frontend/vertex-ai-proxy-interceptor.js.
# Network deployments require an identity gateway protecting HTTP and WebSocket.
# Authenticate via ADC/workload identity; never commit service-account files.
